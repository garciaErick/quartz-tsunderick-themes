{
  // Optional wrangler config for child sites deployed as Cloudflare Workers
  // with static assets. Copy to the child root as wrangler.jsonc and edit
  // `name` + `compatibility_date`. Only needed when the worker was NOT
  // created through the dashboard with an assets directory (i.e. when
  // `npx wrangler deploy` fails with "Could not detect a directory
  // containing static files").
  //
  // - assets.directory must stay ./public (engine/scripts/build.sh output)
  // - not_found_handling: "404-page" serves public/404.html — build.sh
  //   mirrors the subpath 404 there for subpath sites
  // - html_handling defaults to auto-trailing-slash, which Quartz expects
  "name": "your-worker-name",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
